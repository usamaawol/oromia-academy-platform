rules_version = '2';

// Oromia Academy Security Rules
//
// Security Principle:
// - All write operations and sensitive reads happen through the trusted
//   application server (Firebase service account with admin privileges)
// - Browsers get minimal read access and NO write access
// - Answer keys, exam passwords, grading data, and audit logs are never
//   accessible from any client, authenticated or not
// - Role-based access control: owner > instructor > student

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== HELPER FUNCTIONS ====================

    function signedIn() {
      return request.auth != null;
    }

    function myRole() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'none';
    }

    function isOwner() {
      return myRole() == 'owner';
    }

    function isInstructor() {
      return myRole() in ['owner', 'admin', 'instructor'];
    }

    function isStaff() {
      return myRole() in ['owner', 'admin', 'instructor'];
    }

    function isAdmin() {
      return myRole() in ['owner', 'admin'];
    }

    function isEnrolled(courseId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        courseId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enrolledCourseIds;
    }

    function isMyData(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // ==================== USERS COLLECTION ====================
    // User profiles with roles, enrollments, and progress
    match /users/{userId} {
      // Users can read their own profile
      allow get: if isMyData(userId);
      // Staff can list all users for management
      allow list: if isStaff();
      // Users can create their own profile (for signup)
      // Only allow creating with role='student' and matching ID
      allow create: if isMyData(userId) &&
        request.resource.data.id == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.role == 'student' &&
        request.resource.data.status == 'active' &&
        request.resource.data.email == request.auth.token.email;
      // Users can update their own profile (for My Info editing)
      // Cannot change role to prevent escalation; id must stay the document id
      allow update: if isMyData(userId) &&
        request.resource.data.id == userId &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'id', 'uid', 'email', 'fullName', 'phone', 'department',
          'enrolledCourseIds', 'role', 'status', 'createdAt', 'updatedAt'
        ]);
      // No client-side deletes
      allow delete: if false;
    }

    // ==================== COURSES COLLECTION ====================
    // Course catalog information
    match /courses/{courseId} {
      // Public read access for course catalog
      allow get: if true;
      // Staff can list all courses
      allow list: if isStaff();
      // All writes go through server
      allow create, update, delete: if false;
    }

    // ==================== QUESTIONS COLLECTION ====================
    // Question bank with correct answers and rubrics
    // NEVER accessible from clients - server only
    match /questions/{questionId} {
      allow read, write: if false;
    }

    // ==================== EXAMS COLLECTION ====================
    // Exam configurations with passwords and settings
    // Only staff can read exam configurations
    match /exams/{examId} {
      // Staff can read exam configurations
      allow get: if isStaff();
      // Staff can list exams
      allow list: if isStaff();
      // No client writes to prevent exam tampering
      allow create, update, delete: if false;
    }

    // ==================== EXAM SECRETS COLLECTION ====================
    // Hashed exam passwords - NEVER accessible from clients
    match /examSecrets/{examId} {
      allow read, write: if false;
    }

    // ==================== EXAM ATTEMPTS COLLECTION ====================
    // Student exam attempts with answers and scores
    match /examAttempts/{attemptId} {
      // Students can read their own attempts
      allow get: if signedIn() && resource.data.studentId == request.auth.uid;
      // Staff can list and read all attempts for grading
      allow list: if isStaff();
      // No client writes to prevent answer tampering
      allow create, update, delete: if false;
    }

    // ==================== NOTIFICATIONS COLLECTION ====================
    // System notifications for users
    match /notifications/{notificationId} {
      // Users can read notifications sent to them or to all
      allow get: if signedIn() &&
        (resource.data.userId == 'all' || resource.data.userId == request.auth.uid);
      // Users can list their own notifications
      // Queries must be constrained to the caller's own notifications or
      // broadcast notifications; unfiltered collection reads are denied.
      allow list: if signedIn() &&
        (resource.data.userId == 'all' || resource.data.userId == request.auth.uid);
      // No client writes
      allow create, update, delete: if false;
    }

    // ==================== AUDIT LOGS COLLECTION ====================
    // Security audit trail - only owner can read
    match /auditLogs/{entryId} {
      allow read: if isOwner();
      allow list: if isOwner();
      // No client writes
      allow create, update, delete: if false;
    }

    // ==================== SETTINGS COLLECTION ====================
    // Academy-wide settings (public read, server write)
    match /settings/{docId} {
      // Public read access for website content
      allow get: if true;
      allow list: if true;
      // No client writes
      allow create, update, delete: if false;
    }

    // ==================== DEFAULT DENY ====================
    // Anything not explicitly allowed above is denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
