rules_version = '2';

// Oromia Academy Security Rules
//
// Security Principle:
// - All admin/grading writes and sensitive reads run through the application
//   server (TanStack Start server functions). On Hobby / free-tier deployments
//   without a Firebase service account, the server forwards the caller's own
//   Firebase ID token as the Firestore bearer token, so the rules below
//   evaluate with the caller's real identity (request.auth.uid, role lookup in
//   /users) instead of a privileged service account.
// - Role-based access control: owner > admin > instructor > student
// - Answer keys (/questions.correctOptionId / correctBool / rubric) are only
//   ever readable by staff (never by students).
// - Exam passwords (/examSecrets) and audit logs (/auditLogs) stay restricted
//   to the narrowest possible set of callers.

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== HELPER FUNCTIONS ====================

    function signedIn() {
      return request.auth != null;
    }

    function myRole() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'none';
    }

    function isOwner() {
      return myRole() == 'owner';
    }

    function isInstructor() {
      return myRole() in ['owner', 'admin', 'instructor'];
    }

    function isStaff() {
      return myRole() in ['owner', 'admin', 'instructor'];
    }

    function isAdmin() {
      return myRole() in ['owner', 'admin'];
    }

    function isEnrolled(courseId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        courseId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enrolledCourseIds;
    }

    function isMyData(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function canonicalEmail() {
      // Firebase normalises auth token emails to lowercase; profiles must match.
      return signedIn() ? request.auth.token.email.lower() : null;
    }

    // ==================== USERS COLLECTION ====================
    // User profiles with roles, enrollments, and progress
    match /users/{userId} {
      // Users can read their own profile; staff can read any for management
      allow get: if isMyData(userId) || isStaff();
      // Staff can list all users for management
      allow list: if isStaff();
      // Users can create their own profile (for signup)
      // Only allow creating with role='student' and matching ID + canonical email
      allow create: if isMyData(userId) &&
        request.resource.data.id == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.role == 'student' &&
        request.resource.data.status == 'active' &&
        request.resource.data.activationStatus in ['pending'] &&
        (request.resource.data.email.lower() == canonicalEmail());
      // Users can update their own profile (for My Info editing).
      // Role escalation / account suspension is forbidden client-side; only
      // owner/admin via server is allowed to touch role+status.
      allow update: if
        (isMyData(userId) &&
          request.resource.data.id == userId &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.activationStatus == resource.data.activationStatus &&
          (!('approvedBy' in resource.data) || request.resource.data.get('approvedBy', null) == resource.data.get('approvedBy', null)) &&
          (!('approvedAt' in resource.data) || request.resource.data.get('approvedAt', null) == resource.data.get('approvedAt', null)) &&
          (!('rejectedBy' in resource.data) || request.resource.data.get('rejectedBy', null) == resource.data.get('rejectedBy', null)) &&
          (!('assignedActivationCodeId' in resource.data) || request.resource.data.get('assignedActivationCodeId', null) == resource.data.get('assignedActivationCodeId', null)) &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'id', 'uid', 'email', 'fullName', 'phone', 'department', 'nickname',
            'enrolledCourseIds', 'courseIds', 'role', 'status', 'activationStatus',
            'createdAt', 'updatedAt'
          ]))
        // Staff (via server, using caller's own token) may promote users,
        // except nobody can change their OWN role (prevents self-escalation).
        || (isStaff() && request.auth.uid != userId);
      // Server/owner only can ever delete profiles; forbid client-side.
      allow delete: if false;
    }

    // ==================== COURSES COLLECTION ====================
    // Course catalog information
    match /courses/{courseId} {
      // Public read access for course catalog
      allow get: if true;
      // Staff + public list (landing page lists courses too)
      allow list: if true;
      // Staff create / update / archive courses via server (token == caller).
      allow create, update: if isStaff();
      // Only owner can hard-delete courses.
      allow delete: if isOwner();
    }

    // ==================== QUESTIONS COLLECTION ====================
    // Question bank with correctOptionId / correctBool / rubric (answer keys).
    // STAFF ONLY. Students NEVER get read access to the correct answers.
    match /questions/{questionId} {
      allow read, list, create, update: if isStaff();
      // Only owner can permanently delete questions; instructors soft-archive
      // by toggling 'approved' or just stop using them in exams.
      allow delete: if isOwner();
    }

    // ==================== EXAMS COLLECTION ====================
    // Exam configurations with passwords and settings
    match /exams/{examId} {
      // Staff manage exams; students can read basic exam metadata through the
      // server (server uses caller's token → rules still evaluated as student).
      allow get: if isStaff()
        || (signedIn() && request.resource == null
            && resource.data.status == 'active');
      // Staff list exams. Students only see active exams via the
      // `availableExams` server call, which we still allow through the list
      // rule below if the caller is signed in (server returns filtered set).
      allow list: if isStaff() || signedIn();
      // Staff create / update exams via server (caller's own token)
      allow create, update: if isStaff();
      allow delete: if isOwner();
    }

    // ==================== EXAM SECRETS COLLECTION ====================
    // Hashed exam passwords — only OWNER and ADMIN may touch these.
    // Instructors don't need to read hashes; they just use the exam form.
    match /examSecrets/{examId} {
      allow read, write, create, update, delete: if isAdmin();
    }

    // ==================== EXAM ATTEMPTS COLLECTION ====================
    // Student exam attempts with answers and scores
    match /examAttempts/{attemptId} {
      // Students can read their own attempts; staff read any for grading
      allow get: if (signedIn() && resource.data.studentId == request.auth.uid) || isStaff();
      // Staff list all attempts for grading
      allow list: if isStaff()
        || (signedIn() && request.auth.uid != null);
      // Server creates/updates attempts with the caller's token:
      //   - Students: startExam/saveAnswer/submitExam for their own rows
      //   - Staff: grading patch (manualGrades, manualScore, published, …)
      allow create: if
        (signedIn() && request.resource.data.studentId == request.auth.uid)
        || isStaff();
      allow update: if
        (signedIn() && resource.data.studentId == request.auth.uid)
        || isStaff();
      allow delete: if isOwner();
    }

    // ==================== ACTIVATION CODES COLLECTION ====================
    // Stores hashed activation codes. Students NEVER read raw codes or hashes.
    // All code lookups (by hash) and writes (mark used/revoke) go through
    // trusted server functions that validate the caller's role.
    match /activationCodes/{codeId} {
      // Admins can read / list all codes (for the admin panel)
      allow get, list: if isAdmin();
      // Code creation only by admin (via server fn)
      allow create: if isAdmin();
      // Code update only by admin (mark used, revoke, etc.) — via server fn
      allow update: if isAdmin();
      // Hard-delete forbidden — revoke instead (audit trail preserved)
      allow delete: if false;
    }

    // ==================== ENROLLMENTS COLLECTION ====================
    // Course-specific access records. Only created/updated by server fns.
    // Students cannot create fake paid enrollments.
    match /enrollments/{enrollmentId} {
      // Students can read their own enrollments; staff can read all
      allow get: if (signedIn() && resource.data.userId == request.auth.uid) || isStaff();
      allow list: if isStaff()
        || (signedIn() && request.auth.uid != null);
      // Only server (admin acting as caller) may create/update enrollments.
      // Students are explicitly blocked from creating enrollment docs.
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isOwner();
    }

    // ==================== ACTIVATION HISTORY COLLECTION ====================
    // Immutable audit trail for activation events.
    match /activationHistory/{entryId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ==================== ACTIVATION CODE SECRETS COLLECTION ====================
    // Stores the raw (unhashed) activation code for each student.
    // Only readable server-side (admin token) — students NEVER read this directly.
    // The server fn getMyPendingCode reads it and returns only the student's own code
    // after verifying activationStatus === "approved" and userId matches.
    match /activationCodeSecrets/{codeId} {
      // Only admin/owner can read/write these secrets via the server.
      allow get, list, create, update: if isAdmin();
      // Hard-delete forbidden — codes stay for audit.
      allow delete: if false;
    }

    // ==================== NOTIFICATIONS COLLECTION ====================
    // System notifications for users
    match /notifications/{notificationId} {
      // Users can read notifications sent to them or to 'all'
      allow get: if signedIn() &&
        (resource.data.userId == 'all' || resource.data.userId == request.auth.uid);
      // Users can list their own notifications or broadcasts
      allow list: if signedIn() &&
        (resource.data.userId == 'all' || resource.data.userId == request.auth.uid);
      // Staff push notifications via server
      allow create, update, delete: if isStaff();
    }

    // ==================== AUDIT LOGS COLLECTION ====================
    // Security audit trail — only OWNER can read/write.
    match /auditLogs/{entryId} {
      allow read, list, create: if isOwner();
      allow update, delete: if false;
    }

    // ==================== SETTINGS COLLECTION ====================
    // Academy-wide settings (public read, owner/admin write)
    match /settings/{docId} {
      allow get, list: if true;
      allow create, update: if isAdmin();
      allow delete: if isOwner();
    }

    // ==================== DEFAULT DENY ====================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
yu./l;,